    "before": "<section id=\"panel-tab-2\" class=\"tab-panel\" data-tab=\"tab-2\" role=\"tabpanel\" aria-labelledby=\"tab-btn-2\"><span id=\"tab-2\" style=\"display:none\"></span>\n\n      <div class=\"sentrysim-container\">\n        <!-- 5-Tier Threat Architecture with Trust Boundaries -->\n    <div id=\"sentrysim-workbench\" class=\"workbench-section\">\n      <div class=\"lab-section-header\">\n        <h2>See where an attack stops.</h2>\n        <p>\n          TECH 3498: IT Computer Security • Assignment 2 &amp; Lab 2 Laboratory • Student: <strong>Mawutorwu Klu</strong> (Fall 2026).\n          An interactive threat simulation suite modeling 8 real-world cyberattack vectors, heuristic <strong>Time-to-Compromise (TTC)</strong> keyspace projections, incident forensics, and a dynamic <strong>STRIDE Threat Model</strong>.\n        </p>\n      </div>\n\n            <!-- 5-Tier Architecture & Explicit Simulated Trust Boundaries -->\n      <div class=\"topology-container\" id=\"tracer-topology-section\">\n        <div class=\"topology-header-row\">\n          <div class=\"topology-clean-pill\">⚡ In-Memory Threat Topology • Zero Remote Network/DB Calls</div>\n          <div id=\"tracer-status-banner\" class=\"tracer-status-banner\">\n            <span class=\"tracer-status-dot\"></span>\n            <span id=\"tracer-status-text\">⚡ Tracer Ready — Launch any attack vector below to trace exploit traversal</span>\n          </div>\n        </div>\n\n        <div class=\"topology-pipeline-wrapper\" id=\"topology-pipeline-wrapper\">\n          <!-- Animated Conduit Track & Moving Packet -->\n          <div class=\"pipeline-track\" id=\"pipeline-track\">\n            <div class=\"pipeline-line-bg\"></div>\n            <div id=\"tracer-packet\" class=\"tracer-packet\" aria-hidden=\"true\">\n              <span class=\"tracer-packet-core\"></span>\n              <span class=\"tracer-packet-trail\"></span>\n            </div>\n          </div>\n\n          <div class=\"tiers-pipeline-grid\">\n            <!-- Tier 1 -->\n            <div class=\"tier-card\" id=\"tier-1-card\" data-tier=\"1\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 1</span>\n                <span class=\"tier-status-indicator\" id=\"tier-1-status\">CLIENT</span>\n              </div>\n              <h4 class=\"tier-title\">Client / Browser</h4>\n              <p class=\"tier-desc\">Client DOM, event loop, and user input surface.</p>\n              <div class=\"trust-boundary-tag\">\n                <span>🚨</span> TB-1: Untrusted Surface\n              </div>\n            </div>\n\n            <!-- Conduit TB 1 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb1\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-1: TLS 1.3</span>\n            </div>\n\n            <!-- Tier 2 -->\n            <div class=\"tier-card\" id=\"tier-2-card\" data-tier=\"2\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 2</span>\n                <span class=\"tier-status-indicator\" id=\"tier-2-status\">INGRESS</span>\n              </div>\n              <h4 class=\"tier-title\">Perimeter / WAF</h4>\n              <p class=\"tier-desc\">Signature filtering &amp; burst rate clamps.</p>\n              <div class=\"trust-boundary-tag dmz\">\n                <span>🛡️</span> TB-2: Ingress DMZ\n              </div>\n            </div>\n\n            <!-- Conduit TB 2 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb2\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-2: Ingress / CSP</span>\n            </div>\n\n            <!-- Tier 3 -->\n            <div class=\"tier-card\" id=\"tier-3-card\" data-tier=\"3\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 3</span>\n                <span class=\"tier-status-indicator\" id=\"tier-3-status\">CORE</span>\n              </div>\n              <h4 class=\"tier-title\">App Core / Router</h4>\n              <p class=\"tier-desc\">Business logic, keyspace models &amp; AST bind.</p>\n              <div class=\"trust-boundary-tag internal\">\n                <span>⚙️</span> TB-3: Internal Compute\n              </div>\n            </div>\n\n            <!-- Conduit TB 3 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb3\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-3: Param Bound</span>\n            </div>\n\n            <!-- Tier 4 -->\n            <div class=\"tier-card\" id=\"tier-4-card\" data-tier=\"4\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 4</span>\n                <span class=\"tier-status-indicator\" id=\"tier-4-status\">AI</span>\n              </div>\n              <h4 class=\"tier-title\">K.E.A.N. AI Sentry</h4>\n              <p class=\"tier-desc\">Conversational debriefer &amp; prompt sandbox.</p>\n              <div class=\"trust-boundary-tag ai\">\n                <span>🤖</span> TB-4: AI Sandbox\n              </div>\n            </div>\n\n            <!-- Conduit TB 4 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb4\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-4: Isolation</span>\n            </div>\n\n            <!-- Tier 5 -->\n            <div class=\"tier-card\" id=\"tier-5-card\" data-tier=\"5\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 5</span>\n                <span class=\"tier-status-indicator\" id=\"tier-5-status\">VAULT</span>\n              </div>\n              <h4 class=\"tier-title\">Storage / Vault</h4>\n              <p class=\"tier-desc\">Mock credential store &amp; PBKDF2 salt vault.</p>\n              <div class=\"trust-boundary-tag vault\">\n                <span>🔒</span> TB-5: Vault Storage\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- SentrySim 3-Tab Workspace Navigation Bar -->\n\n        <!-- Defenses, Predictive TTC, 8-Vector Arsenal, and Ingress Telemetry -->\n        <!-- 5 Configurable Defense Controls -->\n        <div class=\"saas-card v2-defenses\" style=\"margin-bottom: 24px;\">\n          <div class=\"card-header-row\">\n            <h3 class=\"card-title\"><span>🛡️</span> Your defenses</h3>\n            <span class=\"card-badge\" id=\"sentry-defense-summary-badge\">Defenses: Full Hardening (5/5)</span>\n          </div>\n\n          <p style=\"font-size: 13.5px; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;\">\n            Toggle defensive layers below to observe how each mitigation impacts ingress filtering, query safety, and client execution across the 8 attack vectors:\n          </p>\n\n          <div class=\"defense-controls-grid\">\n            <!-- Toggle 1: WAF -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-waf\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">1. Web App Firewall</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle Web Application Firewall\">\n                  <input type=\"checkbox\" id=\"toggle-waf\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-waf\">ON (Signature Filter)</span>\n            </div>\n\n            <!-- Toggle 2: Rate Limiting -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-ratelimit\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">2. Ingress Rate Limiter</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle Ingress Rate Limiting\">\n                  <input type=\"checkbox\" id=\"toggle-ratelimit\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-ratelimit\">ON (5 req/s Clamp)</span>\n            </div>\n\n            <!-- Toggle 3: DB Parameterization -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-paramsql\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">3. Database Queries</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle Database Query Parameterization\">\n                  <input type=\"checkbox\" id=\"toggle-paramsql\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-paramsql\">Parameterized SQL</span>\n            </div>\n\n            <!-- Toggle 4: DOM Sanitization -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-domsafe\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">4. DOM Context Render</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle DOM Context Sanitization\">\n                  <input type=\"checkbox\" id=\"toggle-domsafe\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-domsafe\">textContent (Safe)</span>\n            </div>\n\n            <!-- Toggle 5: PBKDF2 vs Fast Hash -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-pbkdf2\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">5. Credential Storage</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle PBKDF2 Password Hashing\">\n                  <input type=\"checkbox\" id=\"toggle-pbkdf2\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-pbkdf2\">PBKDF2 (100k + Salt)</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Predictive Time-to-Compromise (TTC) Dashboard -->\n        <div class=\"ttc-dashboard-card\" id=\"ttc-engine-section\">\n          <div class=\"ttc-header-row\">\n            <h3 class=\"card-title\"><span>⏱️</span> Estimated time to compromise</h3>\n            <span class=\"ttc-formula-pill\">TTC = (2^Entropy / Hash_Rate) × ∏(Defense_Multipliers)</span>\n          </div>\n\n          <p style=\"font-size: 13.5px; color: var(--text-muted); line-height: 1.5;\">\n            Our heuristic model projects breach latency by balancing keyspace entropy against an 8x RTX 4090 cluster (100 GH/s base) scaled by active defense friction:\n          </p>\n\n          <!-- Digital Cracking Timer Display -->\n          <div class=\"timer-display-grid\">\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-years\">00</span>\n              <span class=\"timer-label\">Years</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-months\">00</span>\n              <span class=\"timer-label\">Months</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-days\">00</span>\n              <span class=\"timer-label\">Days</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-hours\">00</span>\n              <span class=\"timer-label\">Hours</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-minutes\">00</span>\n              <span class=\"timer-label\">Minutes</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-seconds\">00</span>\n              <span class=\"timer-label\">Seconds</span>\n            </div>\n          </div>\n\n          <!-- Heat Death / Verdict Banner -->\n          <div class=\"ttc-verdict-banner\" id=\"ttc-verdict-banner\">\n            <span id=\"ttc-verdict-text\">Calculating resistance depth...</span>\n            <span style=\"font-family: var(--font-mono); font-size: 11px;\" id=\"ttc-active-multipliers-tag\">Multipliers: 10^14x</span>\n          </div>\n\n          <!-- Exhaustion Depth Traversal Bar -->\n          <div class=\"traversal-container\">\n            <div class=\"traversal-header\">\n              <span>Resistance to guessing</span>\n              <span id=\"traversal-percent-label\" style=\"font-family: var(--font-mono); font-weight: 700;\">100% (Impenetrable)</span>\n            </div>\n            <div class=\"traversal-track\">\n              <div class=\"traversal-fill\" id=\"traversal-progress-fill\" style=\"width: 100%;\"></div>\n            </div>\n          </div>\n\n          <!-- Entropy Scenario Presets -->\n          <div class=\"entropy-selector-row\">\n            <span style=\"font-weight: 700; color: var(--text-heading);\">Test Credential Entropy:</span>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-32\" data-entropy=\"32\">32-Bit (PIN / Word)</button>\n            <button type=\"button\" class=\"entropy-btn active\" id=\"btn-ent-41\" data-entropy=\"41\">41-Bit (Standard Baseline &lt;30s)</button>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-64\" data-entropy=\"64\">64-Bit (Diceware Passphrase)</button>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-128\" data-entropy=\"128\">128-Bit (Capped Full Hardening)</button>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-live\" data-entropy=\"live\" title=\"Use live effective entropy from AuthGuard (Tab 1)\">⚡ Live AuthGuard (<span id=\"sentry-live-entropy-val\">0</span>b)</button>\n          </div>\n        </div>\n\n        <!-- 8-Vector Attack Injection Arsenal -->\n        <div class=\"saas-card\" style=\"margin-bottom: 24px;\">\n          <div class=\"card-header-row\">\n            <h3 class=\"card-title\"><span>🎯</span> Choose an attack</h3>\n            <span class=\"card-badge\">Simulated Payloads • In-Memory Only</span>\n          </div>\n\n          <p style=\"font-size: 13.5px; color: var(--text-muted); line-height: 1.5;\">\n            Run a simulated attack to see how your defenses respond.\n          </p>\n\n          <div class=\"attack-arsenal-grid\">\n\n            <!-- Vector 1: Credential Stuffing -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[1] AUTH</span>\n                <span class=\"attack-target-tier\">Target: Tier 2 &amp; 5</span>\n              </div>\n              <h4 class=\"attack-title\">Automated Credential Stuffing / Hydra Spray</h4>\n              <p class=\"attack-desc\">High-concurrency dictionary spray against the authentication login gateway.</p>\n              <div class=\"payload-snippet-box\">POST /api/auth/login [Burst: 50 attempts/s]</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-1\">\n                <span>🚀</span> Run Hydra spray\n              </button>\n            </div>\n\n            <!-- Vector 2: Path Traversal / IDOR -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[2] AUTHZ</span>\n                <span class=\"attack-target-tier\">Target: Tier 2 &amp; 3</span>\n              </div>\n              <h4 class=\"attack-title\">Path Traversal &amp; IDOR Bypass</h4>\n              <p class=\"attack-desc\">Forced horizontal privilege traversal attempting to harvest administrative tokens.</p>\n              <div class=\"payload-snippet-box\">GET /api/users/1/admin-token</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-2\">\n                <span>🚀</span> Run IDOR test\n              </button>\n            </div>\n\n            <!-- Vector 3: SQL Injection -->\n            <div class=\"attack-card\" id=\"card-attack-3\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[3] INJECT</span>\n                <span class=\"attack-target-tier\">Target: Tier 3 &amp; 5</span>\n              </div>\n              <h4 class=\"attack-title\">SQLi: Classic Boolean Bypass</h4>\n              <p class=\"attack-desc\" id=\"desc-attack-3\">Tautological condition injection designed to force query evaluation to true.</p>\n              <div class=\"payload-snippet-box\">' OR '1'='1' --</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-3\">\n                <span>🚀</span> Run SQL injection\n              </button>\n            </div>\n\n            <!-- Vector 4: Cross-Site Scripting (XSS) -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[4] XSS</span>\n                <span class=\"attack-target-tier\">Target: Tier 1 (Client)</span>\n              </div>\n              <h4 class=\"attack-title\">Stored / Reflected DOM XSS</h4>\n              <p class=\"attack-desc\">Malicious event-handler vector. Executes via <code>innerHTML</code> when unprotected; rendered inert via <code>textContent</code>.</p>\n              <div class=\"payload-snippet-box\">&lt;img src=x onerror=\"alert('XSS-3498')\"&gt;</div>\n              <div class=\"sandbox-preview-container\" id=\"xss-sandbox-output\">\n                <span style=\"color: var(--text-muted); font-size: 11px;\">(XSS DOM Reflection Sandbox Ready)</span>\n              </div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-4\">\n                <span>🚀</span> Run XSS test\n              </button>\n            </div>\n\n            <!-- Vector 5: ReDoS -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[5] DOS</span>\n                <span class=\"attack-target-tier\">Target: Tier 3 (Core)</span>\n              </div>\n              <h4 class=\"attack-title\">Catastrophic Regex Backtracking (ReDoS)</h4>\n              <p class=\"attack-desc\">Exponential state explosion attempting event-loop CPU starvation (guarded by timeout).</p>\n              <div class=\"payload-snippet-box\">/^(a+)+$/ vs \"aaaaaaaaaaaaaaaaaaaaa!\"</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-5\">\n                <span>🚀</span> Run ReDoS test\n              </button>\n            </div>\n\n            <!-- Vector 6: GPU Cluster Cracking -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[6] CRYPTO</span>\n                <span class=\"attack-target-tier\">Target: Tier 5 (Vault)</span>\n              </div>\n              <h4 class=\"attack-title\">8x RTX 4090 GPU Mask Crack</h4>\n              <p class=\"attack-desc\">Simulated 100 GH/s hashcat cluster mask attack against stored credential records.</p>\n              <div class=\"payload-snippet-box\">Mask: ?u?l?l?l?d?d?d?d?s (100 GH/s)</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-6\">\n                <span>🚀</span> Execute GPU Cluster Crack\n              </button>\n            </div>\n\n            <!-- Vector 7: Cache Sniffing -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[7] LEAK</span>\n                <span class=\"attack-target-tier\">Target: Tier 1 &amp; 2</span>\n              </div>\n              <h4 class=\"attack-title\">Cache Sniffing &amp; Cleartext Ingress</h4>\n              <p class=\"attack-desc\">Simulates token leakage via insecure caching and missing transport controls.</p>\n              <div class=\"payload-snippet-box\">GET /account?token=Bearer_SecToken98</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-7\">\n                <span>🚀</span> Test token leakage\n              </button>\n            </div>\n\n            <!-- Vector 8: Mock Microphone Hijack -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[8] PRIV</span>\n                <span class=\"attack-target-tier\">Target: Tier 1 (Sandbox)</span>\n              </div>\n              <h4 class=\"attack-title\">Ambient Audio WebRTC Hijack (Mock)</h4>\n              <p class=\"attack-desc\">Simulated hardware peripheral probe. Pure visual animation—zero real permissions or calls.</p>\n              <div class=\"payload-snippet-box\">MOCK_STREAM://audio.webrtc.probe</div>\n              <div class=\"mock-mic-visualizer\" id=\"mock-mic-box\">\n                <span style=\"font-weight: 700;\">[MOCK SIMULATION ONLY — ZERO REAL MIC ACCESS]</span>\n                <div class=\"wave-bars\" style=\"margin-top: 4px;\">\n                  <span class=\"wave-bar\"></span>\n                  <span class=\"wave-bar\"></span>\n                  <span class=\"wave-bar\"></span>\n                  <span class=\"wave-bar\"></span>\n                </div>\n              </div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-8\">\n                <span>🚀</span> Run mock audio probe\n              </button>\n            </div>\n\n          </div>\n\n          <!-- Live Ingress Telemetry Terminal -->\n          <div class=\"telemetry-card\">\n            <div class=\"telemetry-header\">\n              <div class=\"telemetry-dots\">\n                <span class=\"t-dot t-dot-red\"></span>\n                <span class=\"t-dot t-dot-yellow\"></span>\n                <span class=\"t-dot t-dot-green\"></span>\n              </div>\n              <span class=\"telemetry-title\">sentry-waf@tier-2:~/ingress-telemetry.log</span>\n              <div class=\"telemetry-controls\">\n                <button type=\"button\" id=\"btn-copy-telemetry\" class=\"btn-terminal-sm\">📋 Copy Log</button>\n                <button type=\"button\" id=\"btn-clear-telemetry\" class=\"btn-terminal-sm\">🗑️ Clear</button>\n              </div>\n            </div>\n            <div class=\"telemetry-body\" id=\"telemetry-terminal-body\">// SentrySim WAF Ingress Telemetry Terminal initialized.\n// Defenses: WAF (Active), Rate Limiter (Active), Parameterized Queries (Active), DOM Safe (Active), PBKDF2 (Active).\n// Ready for simulated attack packet injection. Select any attack above to inspect packet traversal.</div>\n          </div>\n\n        </div>\n\n      </div>\n\n      </section>",
    "after": "<section id=\"panel-tab-2\" class=\"tab-panel\" data-tab=\"tab-2\" role=\"tabpanel\" aria-labelledby=\"tab-btn-2\"><span id=\"tab-2\" style=\"display:none\"></span>\n\n      <div class=\"sentrysim-container\">\n        <!-- 5-Tier Threat Architecture with Trust Boundaries -->\n    <div id=\"sentrysim-workbench\" class=\"workbench-section\">\n      <div class=\"lab-section-header\">\n        <h2>See where an attack stops.</h2>\n        <p>\n          TECH 3498: IT Computer Security • Assignment 2 &amp; Lab 2 Laboratory • Student: <strong>Mawutorwu Klu</strong> (Fall 2026).\n          An interactive threat simulation suite modeling 8 real-world cyberattack vectors, heuristic <strong>Time-to-Compromise (TTC)</strong> keyspace projections, incident forensics, and a dynamic <strong>STRIDE Threat Model</strong>.\n        </p>\n      </div>\n\n            <!-- 5-Tier Architecture & Explicit Simulated Trust Boundaries -->\n      <div class=\"topology-container\" id=\"tracer-topology-section\">\n        <div class=\"topology-header-row\">\n          <div class=\"topology-clean-pill\">⚡ In-Memory Threat Topology • Zero Remote Network/DB Calls</div>\n          <div id=\"tracer-status-banner\" class=\"tracer-status-banner\">\n            <span class=\"tracer-status-dot\"></span>\n            <span id=\"tracer-status-text\">⚡ Tracer Ready — Launch any attack vector below to trace exploit traversal</span>\n          </div>\n        </div>\n\n        <div class=\"topology-pipeline-wrapper\" id=\"topology-pipeline-wrapper\">\n          <!-- Animated Conduit Track & Moving Packet -->\n          <div class=\"pipeline-track\" id=\"pipeline-track\">\n            <div class=\"pipeline-line-bg\"></div>\n            <div id=\"tracer-packet\" class=\"tracer-packet\" aria-hidden=\"true\">\n              <span class=\"tracer-packet-core\"></span>\n              <span class=\"tracer-packet-trail\"></span>\n            </div>\n          </div>\n\n          <div class=\"tiers-pipeline-grid\">\n            <!-- Tier 1 -->\n            <div class=\"tier-card\" id=\"tier-1-card\" data-tier=\"1\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 1</span>\n                <span class=\"tier-status-indicator\" id=\"tier-1-status\">CLIENT</span>\n              </div>\n              <h4 class=\"tier-title\">Client / Browser</h4>\n              <p class=\"tier-desc\">Client DOM, event loop, and user input surface.</p>\n              <div class=\"trust-boundary-tag\">\n                <span>🚨</span> TB-1: Untrusted Surface\n              </div>\n            </div>\n\n            <!-- Conduit TB 1 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb1\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-1: TLS 1.3</span>\n            </div>\n\n            <!-- Tier 2 -->\n            <div class=\"tier-card\" id=\"tier-2-card\" data-tier=\"2\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 2</span>\n                <span class=\"tier-status-indicator\" id=\"tier-2-status\">INGRESS</span>\n              </div>\n              <h4 class=\"tier-title\">Perimeter / WAF</h4>\n              <p class=\"tier-desc\">Signature filtering &amp; burst rate clamps.</p>\n              <div class=\"trust-boundary-tag dmz\">\n                <span>🛡️</span> TB-2: Ingress DMZ\n              </div>\n            </div>\n\n            <!-- Conduit TB 2 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb2\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-2: Ingress / CSP</span>\n            </div>\n\n            <!-- Tier 3 -->\n            <div class=\"tier-card\" id=\"tier-3-card\" data-tier=\"3\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 3</span>\n                <span class=\"tier-status-indicator\" id=\"tier-3-status\">CORE</span>\n              </div>\n              <h4 class=\"tier-title\">App Core / Router</h4>\n              <p class=\"tier-desc\">Business logic, keyspace models &amp; AST bind.</p>\n              <div class=\"trust-boundary-tag internal\">\n                <span>⚙️</span> TB-3: Internal Compute\n              </div>\n            </div>\n\n            <!-- Conduit TB 3 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb3\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-3: Param Bound</span>\n            </div>\n\n            <!-- Tier 4 -->\n            <div class=\"tier-card\" id=\"tier-4-card\" data-tier=\"4\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 4</span>\n                <span class=\"tier-status-indicator\" id=\"tier-4-status\">AI</span>\n              </div>\n              <h4 class=\"tier-title\">K.E.A.N. AI Sentry</h4>\n              <p class=\"tier-desc\">Conversational debriefer &amp; prompt sandbox.</p>\n              <div class=\"trust-boundary-tag ai\">\n                <span>🤖</span> TB-4: AI Sandbox\n              </div>\n            </div>\n\n            <!-- Conduit TB 4 -->\n            <div class=\"pipeline-conduit\" id=\"conduit-tb4\">\n              <div class=\"conduit-line\"><span class=\"conduit-pulse\"></span></div>\n              <span class=\"conduit-tag\">TB-4: Isolation</span>\n            </div>\n\n            <!-- Tier 5 -->\n            <div class=\"tier-card\" id=\"tier-5-card\" data-tier=\"5\">\n              <div class=\"tier-header-badge-row\">\n                <span class=\"tier-number-badge\">Tier 5</span>\n                <span class=\"tier-status-indicator\" id=\"tier-5-status\">VAULT</span>\n              </div>\n              <h4 class=\"tier-title\">Storage / Vault</h4>\n              <p class=\"tier-desc\">Mock credential store &amp; PBKDF2 salt vault.</p>\n              <div class=\"trust-boundary-tag vault\">\n                <span>🔒</span> TB-5: Vault Storage\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- SentrySim 3-Tab Workspace Navigation Bar -->\n\n        <!-- Defenses, Predictive TTC, 8-Vector Arsenal, and Ingress Telemetry -->\n        <!-- 5 Configurable Defense Controls -->\n        <div class=\"saas-card v2-defenses\" style=\"margin-bottom: 24px;\">\n          <div class=\"card-header-row\">\n            <h3 class=\"card-title\"><span>🛡️</span> Your defenses</h3>\n            <span class=\"card-badge\" id=\"sentry-defense-summary-badge\">Defenses: Full Hardening (5/5)</span>\n          </div>\n\n          <p style=\"font-size: 13.5px; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;\">\n            Toggle defensive layers below to observe how each mitigation impacts ingress filtering, query safety, and client execution across the 8 attack vectors:\n          </p>\n\n          <div class=\"defense-controls-grid\">\n            <!-- Toggle 1: WAF -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-waf\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">1. Web App Firewall</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle Web Application Firewall\">\n                  <input type=\"checkbox\" id=\"toggle-waf\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-waf\">ON (Signature Filter)</span>\n            </div>\n\n            <!-- Toggle 2: Rate Limiting -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-ratelimit\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">2. Ingress Rate Limiter</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle Ingress Rate Limiting\">\n                  <input type=\"checkbox\" id=\"toggle-ratelimit\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-ratelimit\">ON (5 req/s Clamp)</span>\n            </div>\n\n            <!-- Toggle 3: DB Parameterization -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-paramsql\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">3. Database Queries</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle Database Query Parameterization\">\n                  <input type=\"checkbox\" id=\"toggle-paramsql\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-paramsql\">Parameterized SQL</span>\n            </div>\n\n            <!-- Toggle 4: DOM Sanitization -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-domsafe\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">4. DOM Context Render</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle DOM Context Sanitization\">\n                  <input type=\"checkbox\" id=\"toggle-domsafe\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-domsafe\">textContent (Safe)</span>\n            </div>\n\n            <!-- Toggle 5: PBKDF2 vs Fast Hash -->\n            <div class=\"defense-toggle-card active\" id=\"card-toggle-pbkdf2\">\n              <div class=\"defense-label-row\">\n                <span class=\"defense-title\">5. Credential Storage</span>\n                <label class=\"switch-ui\" aria-label=\"Toggle PBKDF2 Password Hashing\">\n                  <input type=\"checkbox\" id=\"toggle-pbkdf2\" checked>\n                  <span class=\"switch-slider\"></span>\n                </label>\n              </div>\n              <span class=\"defense-status-pill\" id=\"status-pbkdf2\">PBKDF2 (100k + Salt)</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Predictive Time-to-Compromise (TTC) Dashboard -->\n        <div class=\"ttc-dashboard-card\" id=\"ttc-engine-section\">\n          <div class=\"ttc-header-row\">\n            <h3 class=\"card-title\"><span>⏱️</span> Estimated time to compromise</h3>\n            <span class=\"ttc-formula-pill\">TTC = (2^Entropy / Hash_Rate) × ∏(Defense_Multipliers)</span>\n          </div>\n\n          <p style=\"font-size: 13.5px; color: var(--text-muted); line-height: 1.5;\">\n            Our heuristic model projects breach latency by balancing keyspace entropy against an 8x RTX 4090 cluster (100 GH/s base) scaled by active defense friction:\n          </p>\n\n          <!-- Digital Cracking Timer Display -->\n          <div class=\"timer-display-grid\">\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-years\">00</span>\n              <span class=\"timer-label\">Years</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-months\">00</span>\n              <span class=\"timer-label\">Months</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-days\">00</span>\n              <span class=\"timer-label\">Days</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-hours\">00</span>\n              <span class=\"timer-label\">Hours</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-minutes\">00</span>\n              <span class=\"timer-label\">Minutes</span>\n            </div>\n            <div class=\"timer-unit-box\">\n              <span class=\"timer-val\" id=\"sentry-timer-seconds\">00</span>\n              <span class=\"timer-label\">Seconds</span>\n            </div>\n          </div>\n\n          <!-- Heat Death / Verdict Banner -->\n          <div class=\"ttc-verdict-banner\" id=\"ttc-verdict-banner\">\n            <span id=\"ttc-verdict-text\">Calculating resistance depth...</span>\n            <span style=\"font-family: var(--font-mono); font-size: 11px;\" id=\"ttc-active-multipliers-tag\">Multipliers: 10^14x</span>\n          </div>\n\n          <!-- Exhaustion Depth Traversal Bar -->\n          <div class=\"traversal-container\">\n            <div class=\"traversal-header\">\n              <span>Resistance to guessing</span>\n              <span id=\"traversal-percent-label\" style=\"font-family: var(--font-mono); font-weight: 700;\">100% (Impenetrable)</span>\n            </div>\n            <div class=\"traversal-track\">\n              <div class=\"traversal-fill\" id=\"traversal-progress-fill\" style=\"width: 100%;\"></div>\n            </div>\n          </div>\n\n          <!-- Entropy Scenario Presets -->\n          <div class=\"entropy-selector-row\">\n            <span style=\"font-weight: 700; color: var(--text-heading);\">Test Credential Entropy:</span>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-32\" data-entropy=\"32\">32-Bit (PIN / Word)</button>\n            <button type=\"button\" class=\"entropy-btn active\" id=\"btn-ent-41\" data-entropy=\"41\">41-Bit (Standard Baseline &lt;30s)</button>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-64\" data-entropy=\"64\">64-Bit (Diceware Passphrase)</button>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-128\" data-entropy=\"128\">128-Bit (Capped Full Hardening)</button>\n            <button type=\"button\" class=\"entropy-btn\" id=\"btn-ent-live\" data-entropy=\"live\" title=\"Use live effective entropy from AuthGuard (Tab 1)\">⚡ Live AuthGuard (<span id=\"sentry-live-entropy-val\">0</span>b)</button>\n          </div>\n        </div>\n\n        <!-- 8-Vector Attack Injection Arsenal -->\n        <div class=\"saas-card\" style=\"margin-bottom: 24px;\">\n          <div class=\"card-header-row\">\n            <h3 class=\"card-title\"><span>🎯</span> Choose an attack</h3>\n            <span class=\"card-badge\">Simulated Payloads • In-Memory Only</span>\n          </div>\n\n          <p style=\"font-size: 13.5px; color: var(--text-muted); line-height: 1.5;\">\n            Run a simulated attack to see how your defenses respond.\n          </p>\n\n          <div class=\"attack-arsenal-grid\">\n\n            <!-- Vector 1: Credential Stuffing -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[1] AUTH</span>\n                <span class=\"attack-target-tier\">Target: Tier 2 &amp; 5</span>\n              </div>\n              <h4 class=\"attack-title\">Automated Credential Stuffing / Hydra Spray</h4>\n              <p class=\"attack-desc\">High-concurrency dictionary spray against the authentication login gateway.</p>\n              <div class=\"payload-snippet-box\">POST /api/auth/login [Burst: 50 attempts/s]</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-1\">\n                <span>🚀</span> Run Hydra spray\n              </button>\n            </div>\n\n            <!-- Vector 2: Path Traversal / IDOR -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[2] AUTHZ</span>\n                <span class=\"attack-target-tier\">Target: Tier 2 &amp; 3</span>\n              </div>\n              <h4 class=\"attack-title\">Path Traversal &amp; IDOR Bypass</h4>\n              <p class=\"attack-desc\">Forced horizontal privilege traversal attempting to harvest administrative tokens.</p>\n              <div class=\"payload-snippet-box\">GET /api/users/1/admin-token</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-2\">\n                <span>🚀</span> Run IDOR test\n              </button>\n            </div>\n\n            <!-- Vector 3: SQL Injection -->\n            <div class=\"attack-card\" id=\"card-attack-3\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[3] INJECT</span>\n                <span class=\"attack-target-tier\">Target: Tier 3 &amp; 5</span>\n              </div>\n              <h4 class=\"attack-title\">SQLi: Classic Boolean Bypass</h4>\n              <p class=\"attack-desc\" id=\"desc-attack-3\">Tautological condition injection designed to force query evaluation to true.</p>\n              <div class=\"payload-snippet-box\">' OR '1'='1' --</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-3\">\n                <span>🚀</span> Run SQL injection\n              </button>\n            </div>\n\n            <!-- Vector 4: Cross-Site Scripting (XSS) -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[4] XSS</span>\n                <span class=\"attack-target-tier\">Target: Tier 1 (Client)</span>\n              </div>\n              <h4 class=\"attack-title\">Stored / Reflected DOM XSS</h4>\n              <p class=\"attack-desc\">Malicious event-handler vector. Executes via <code>innerHTML</code> when unprotected; rendered inert via <code>textContent</code>.</p>\n              <div class=\"payload-snippet-box\">&lt;img src=x onerror=\"alert('XSS-3498')\"&gt;</div>\n              <div class=\"sandbox-preview-container\" id=\"xss-sandbox-output\">\n                <span style=\"color: var(--text-muted); font-size: 11px;\">(XSS DOM Reflection Sandbox Ready)</span>\n              </div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-4\">\n                <span>🚀</span> Run XSS test\n              </button>\n            </div>\n\n            <!-- Vector 5: ReDoS -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[5] DOS</span>\n                <span class=\"attack-target-tier\">Target: Tier 3 (Core)</span>\n              </div>\n              <h4 class=\"attack-title\">Catastrophic Regex Backtracking (ReDoS)</h4>\n              <p class=\"attack-desc\">Exponential state explosion attempting event-loop CPU starvation (guarded by timeout).</p>\n              <div class=\"payload-snippet-box\">/^(a+)+$/ vs \"aaaaaaaaaaaaaaaaaaaaa!\"</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-5\">\n                <span>🚀</span> Run ReDoS test\n              </button>\n            </div>\n\n            <!-- Vector 6: GPU Cluster Cracking -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[6] CRYPTO</span>\n                <span class=\"attack-target-tier\">Target: Tier 5 (Vault)</span>\n              </div>\n              <h4 class=\"attack-title\">8x RTX 4090 GPU Mask Crack</h4>\n              <p class=\"attack-desc\">Simulated 100 GH/s hashcat cluster mask attack against stored credential records.</p>\n              <div class=\"payload-snippet-box\">Mask: ?u?l?l?l?d?d?d?d?s (100 GH/s)</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-6\">\n                <span>🚀</span> Execute GPU Cluster Crack\n              </button>\n            </div>\n\n            <!-- Vector 7: Cache Sniffing -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[7] LEAK</span>\n                <span class=\"attack-target-tier\">Target: Tier 1 &amp; 2</span>\n              </div>\n              <h4 class=\"attack-title\">Cache Sniffing &amp; Cleartext Ingress</h4>\n              <p class=\"attack-desc\">Simulates token leakage via insecure caching and missing transport controls.</p>\n              <div class=\"payload-snippet-box\">GET /account?token=Bearer_SecToken98</div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-7\">\n                <span>🚀</span> Test token leakage\n              </button>\n            </div>\n\n            <!-- Vector 8: Mock Microphone Hijack -->\n            <div class=\"attack-card\">\n              <div class=\"attack-card-header\">\n                <span class=\"attack-vector-badge\">[8] PRIV</span>\n                <span class=\"attack-target-tier\">Target: Tier 1 (Sandbox)</span>\n              </div>\n              <h4 class=\"attack-title\">Ambient Audio WebRTC Hijack (Mock)</h4>\n              <p class=\"attack-desc\">Simulated hardware peripheral probe. Pure visual animation—zero real permissions or calls.</p>\n              <div class=\"payload-snippet-box\">MOCK_STREAM://audio.webrtc.probe</div>\n              <div class=\"mock-mic-visualizer\" id=\"mock-mic-box\">\n                <span style=\"font-weight: 700;\">[MOCK SIMULATION ONLY — ZERO REAL MIC ACCESS]</span>\n                <div class=\"wave-bars\" style=\"margin-top: 4px;\">\n                  <span class=\"wave-bar\"></span>\n                  <span class=\"wave-bar\"></span>\n                  <span class=\"wave-bar\"></span>\n                  <span class=\"wave-bar\"></span>\n                </div>\n              </div>\n              <button type=\"button\" class=\"btn-launch-attack\" id=\"btn-attack-8\">\n                <span>🚀</span> Run mock audio probe\n              </button>\n            </div>\n\n          </div>\n\n          <!-- Live Ingress Telemetry Terminal -->\n          <div class=\"telemetry-card\">\n            <div class=\"telemetry-header\">\n              <div class=\"telemetry-dots\">\n                <span class=\"t-dot t-dot-red\"></span>\n                <span class=\"t-dot t-dot-yellow\"></span>\n                <span class=\"t-dot t-dot-green\"></span>\n              </div>\n              <span class=\"telemetry-title\">sentry-waf@tier-2:~/ingress-telemetry.log</span>\n              <div class=\"telemetry-controls\">\n                <button type=\"button\" id=\"btn-copy-telemetry\" class=\"btn-terminal-sm\">📋 Copy Log</button>\n                <button type=\"button\" id=\"btn-clear-telemetry\" class=\"btn-terminal-sm\">🗑️ Clear</button>\n              </div>\n            </div>\n            <div class=\"telemetry-body\" id=\"telemetry-terminal-body\">// SentrySim WAF Ingress Telemetry Terminal initialized.\n// Defenses: WAF (Active), Rate Limiter (Active), Parameterized Queries (Active), DOM Safe (Active), PBKDF2 (Active).\n// Ready for simulated attack packet injection. Select any attack above to inspect packet traversal.</div>\n          </div>\n\n        </div>\n\n      </div>\n\n        </div>\n    </section>"
